# Export these variables in your shell before running Docker Compose.
# This file is an example only; do not put production credentials here.
RAMP_TOKEN=replace-this-with-a-long-random-lab-token

# Network impairment is applied on both egress interfaces of the transit router.
RAMP_NETEM_DELAY=0ms
RAMP_NETEM_JITTER=0ms
RAMP_NETEM_LOSS=0%
# Empty means no explicit rate limit. Example: 5mbit
RAMP_NETEM_RATE=
